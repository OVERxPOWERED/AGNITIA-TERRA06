# Where the frontend finds the API.
# NEXT_PUBLIC_* values are baked into the JavaScript at build time: change one, then rebuild or restart `next dev`.
#
# 1) Local backend (default if this is left unset in development):
#      cd backend && TERRA_SCHEDULER_ENABLED=false ../.venv/bin/uvicorn app.main:app --port 8000
NEXT_PUBLIC_API_BASE=http://localhost:8000
#
# 2) The deployed API from your laptop: copy this file to .env.local, put the deployed URL here, and add
#    http://localhost:3000 to TERRA_CORS_ORIGINS on the API (comma separated), otherwise the browser blocks every call.
#      NEXT_PUBLIC_API_BASE=https://YOUR-API.onrender.com
#
# 3) Production on Vercel: set NEXT_PUBLIC_API_BASE in the project settings before building.
